# Скопіюйте цей файл у .env і заповніть значення.
# Файл .env не потрапляє в git. На Vercel ті самі змінні задаються в
# Project Settings -> Environment Variables.

# --- Supabase (база даних) ---
# Project Settings -> Data API -> Project URL
SUPABASE_URL="https://mnsqbsxazooykgzmjzug.supabase.co"

# Project Settings -> API Keys -> Secret key (sb_secret_...).
# Потрібен для адмін-панелі (запис). НІКОЛИ не додавайте його в код чи git.
SUPABASE_SECRET_KEY="sb_secret_..."

# Project Settings -> API Keys -> Publishable key (sb_publishable_...).
# Необов'язково: використовується для читання, якщо secret key не задано.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Адміністратори ---
# Необов'язково: email-адреси через кому. Доповнює таблицю admins у базі.
ADMIN_EMAILS="admin@example.com"

# --- Firebase (вхід через Google) ---
FIREBASE_PROJECT_ID="phasmowiki-prod"

# --- Gemini (ШІ-асистент) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-2.5-flash"
